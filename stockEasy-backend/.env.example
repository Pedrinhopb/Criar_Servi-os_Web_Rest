# ─────────────────────────────────────────────
#  StockEasy — Backend
#  Copie este arquivo para .env e preencha os valores
#  NUNCA suba o .env real para o GitHub
# ─────────────────────────────────────────────

# Porta do servidor
PORT=3000

# String de conexão com o MongoDB Atlas
MONGO_URI=mongodb+srv://SEU_USUARIO:SUA_SENHA@cluster.mongodb.net/stockeasy?appName=stockEasy

# Chave secreta para assinar os tokens JWT
# Use uma string longa e aleatória — ex: gerada em https://randomkeygen.com
JWT_SECRET=coloque_uma_chave_secreta_longa_e_aleatoria_aqui
